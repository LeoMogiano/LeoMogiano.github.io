---
/**
 * Términos y privacidad de MiMicro, servidos desde aquí en vez de Flycricket.
 *
 * Página aparte del portafolio a propósito: no usa Base.astro ni sus tokens.
 * Lleva el mundo visual de la app (tokens "Verde monte" / "Grafito" de
 * MyMicro-iOS/Core/DesignSystem, Montserrat) para que quien llega desde
 * Ajustes > Acerca de sienta que sigue dentro de MiMicro.
 *
 * El texto legal vive en src/data/mimicro/<doc>.<lang>.json. El inglés es
 * copia tal cual del documento de Flycricket (vigente 2026-10-30); los otros
 * siete son traducciones de cortesía. Se editan ahí, no aquí.
 *
 * Rutas: /mimicro/terms/ (inglés) y /mimicro/<lang>/terms/. Además, ?lang=xx
 * en cualquiera de ellas redirige al idioma pedido (ver el script del head).
 */
import type { GetStaticPaths } from 'astro';
import { DOC_KEYS, LANGS, UI, getDoc, legalPath, type DocKey, type LegalLang } from '../../data/mimicro/i18n';

export const getStaticPaths = (() =>
  LANGS.flatMap((lang) =>
    DOC_KEYS.map((doc) => ({
      params: { path: lang === 'en' ? doc : `${lang}/${doc}` },
      props: { lang, doc },
    })),
  )) satisfies GetStaticPaths;

const { lang, doc: key } = Astro.props as { lang: LegalLang; doc: DocKey };
const t = UI[lang];
const title = t.title[key];
const data = getDoc(key, lang);
const canonical = new URL(legalPath(key, lang), Astro.site).href;

const effective = new Date(`${data.effective}T12:00:00Z`).toLocaleDateString(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const description = t.description(title, effective);
const CONTACT = 'leomogiano@outlook.com';

/* Material Icons (Apache 2.0), los mismos nombres que usa la app. */
const ICON = {
  bus: 'M4 16c0 .88.39 1.67 1 2.22V20c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h8v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1.78c.61-.55 1-1.34 1-2.22V6c0-3.5-3.58-4-8-4s-8 .5-8 4v10zm3.5 1c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm9 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm1.5-6H6V6h12v5z',
  explore:
    'M12 10.9c-.61 0-1.1.49-1.1 1.1s.49 1.1 1.1 1.1c.61 0 1.1-.49 1.1-1.1s-.49-1.1-1.1-1.1zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm2.19 12.19L6 18l3.81-8.19L18 6l-3.81 8.19z',
  event:
    'M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z',
  mail: 'M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
  list: 'M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/*
      ?lang=xx → ruta del idioma. Va primero en el head para salir antes de pintar.
      Acepta "pt-BR", "es_BO", "ES": se queda con el código base. Un idioma que no
      está cae a inglés, igual que las apps.
    */}
    <script is:inline define:vars={{ doc: key, langs: LANGS }}>
      const q = new URLSearchParams(location.search).get('lang');
      if (q) {
        const base = q.toLowerCase().split(/[-_]/)[0];
        const l = langs.includes(base) ? base : 'en';
        const target = `/mimicro/${l === 'en' ? '' : l + '/'}${doc}/`;
        if (target !== location.pathname) location.replace(target + location.hash);
      }
    </script>
    <title>{title} · {t.brand}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(legalPath(key, l), Astro.site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(legalPath(key, 'en'), Astro.site).href} />
    {/*
      Sin <meta theme-color>, igual que Base.astro: con él Safari iOS pinta sus
      barras de un color sólido; sin él muestrea el fondo de <html> en el borde
      del viewport, que aquí es plano, y la barra queda continua con la página.
    */}
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href="/fonts/montserrat-var.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="icon"
      href={`data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 28"><rect width="28" height="28" rx="9" fill="#2F855A"/><svg x="5" y="5" width="18" height="18" viewBox="0 0 24 24"><path fill="#fff" d="${ICON.bus}"/></svg></svg>`)}`}
    />
  </head>

  <body>
    <a class="skip" href="#doc">{t.skip}</a>

    <div class="deco-clip" aria-hidden="true"><svg class="deco" viewBox="0 0 24 24"><path d={ICON.explore} /></svg></div>

    <header class="top">
      <span class="brand">
        <span class="brand__mark">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.bus} /></svg>
        </span>
        <span class="brand__word">{t.brand.slice(0, 2)}<b>Micro</b></span>
      </span>

      <nav class="seg" aria-label={t.nav}>
        {
          DOC_KEYS.map((k) => (
            <a href={legalPath(k, lang)} aria-current={k === key ? 'page' : undefined}>
              {t.tab[k]}
            </a>
          ))
        }
      </nav>
    </header>

    <div class="layout">
      <div class="intro">
        <h1>{title}</h1>
        <p class="chip">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.event} /></svg>
          {t.effective} <time datetime={data.effective}>{effective}</time>
        </p>
        {
          t.courtesy && (
            <p class="courtesy">
              {t.courtesy}{' '}
              <a href={legalPath(key, 'en')} hreflang="en" lang="en">
                {t.readEnglish}
              </a>
            </p>
          )
        }
      </div>

      <aside class="toc" id="toc">
        <details>
          <summary>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.list} /></svg>
            {t.toc}
          </summary>
          <ol>
            {data.sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
          </ol>
        </details>
      </aside>
      <script is:inline>
        // En móvil el índice arranca cerrado para no empujar el texto; en escritorio es la barra lateral.
        const toc = document.querySelector('.toc details');
        const desk = matchMedia('(min-width: 960px)');
        if (desk.matches) toc.open = true;
        // En escritorio el resumen no es clicable: el teclado tampoco puede cerrarlo.
        toc.addEventListener('toggle', () => { if (desk.matches && !toc.open) toc.open = true; });
      </script>

      <main id="doc" class="doc" tabindex="-1">
        <div class="lede" set:html={data.intro} />
        {
          data.sections.map((s) => (
            <section aria-labelledby={s.id}>
              <h2 id={s.id}>{s.title}</h2>
              <Fragment set:html={s.html} />
            </section>
          ))
        }

        <aside class="ask">
          <span class="ask__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.mail} /></svg>
          </span>
          <div>
            <p class="ask__title">{t.askTitle}</p>
            <p class="ask__text">{t.askText}</p>
          </div>
          <a class="ask__btn" href={`mailto:${CONTACT}?subject=${encodeURIComponent(`${t.brand} · ${title}`)}`}>
            {t.askBtn}
          </a>
        </aside>
        <a class="back" href="#toc">{t.toc} ↑</a>
      </main>
    </div>

    <footer class="foot">
      <nav class="langs" aria-label={t.language}>
        {
          LANGS.map((l) => (
            <a
              href={legalPath(key, l)}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'page' : undefined}
            >
              {UI[l].name}
            </a>
          ))
        }
      </nav>
      <p>
        {t.brand} · Santa Cruz de la Sierra, Bolivia · {t.madeBy} <a href="/">Leo Mogiano</a>
      </p>
      <p>
        {t.generated} <a href="https://app-privacy-policy-generator.nisrulz.com/" rel="noopener"
          >App Privacy Policy Generator</a
        >.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Montserrat';
    src: url('/fonts/montserrat-var.woff2') format('woff2-variations');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  /* Tokens "Verde monte" (claro) / "Grafito" (oscuro), de Color+MM.swift. */
  :root {
    --primary: #2f855a;
    --primary-deep: #23683f;
    --accent-bg: #e6f2ea;
    --bg: #f6f8f5;
    --surface: #ffffff;
    --ink: #18231d;
    --ink-2: #5b6660;
    --ink-3: #3a4540;
    --line: #e3e8e3;
    --soft: #eef1ee;
    --deco: #cfe5d6;
    --shadow: 24 35 29;
    --on-primary: #ffffff;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --primary-deep: #94d6af;
      --accent-bg: #24402f;
      --bg: #1f2022;
      --surface: #2a2b2e;
      --ink: #eceeec;
      --ink-2: #aeb3b0;
      --ink-3: #d0d4d1;
      --line: #3a3c40;
      --soft: #323437;
      --deco: #2e3a33;
      --shadow: 0 0 0;
      color-scheme: dark;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    /* Fondo en <html>: es lo que Safari muestrea para teñir sus barras. */
    background-color: var(--bg);
    -webkit-text-size-adjust: 100%;
    -webkit-tap-highlight-color: transparent;
    scroll-behavior: smooth;
    scroll-padding-top: calc(24px + env(safe-area-inset-top));
    scrollbar-color: var(--line) var(--bg);
    accent-color: var(--primary);
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 500 16px/1.65 'Montserrat', system-ui, sans-serif;
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
    caret-color: var(--primary);
    overflow-wrap: break-word;
    overflow-x: clip;
    position: relative;
    min-height: 100dvh;
  }

  ::selection {
    background: var(--accent-bg);
    color: var(--primary-deep);
  }

  :focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
    border-radius: 6px;
  }

  a {
    color: var(--primary-deep);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, var(--primary) 45%, transparent);
  }
  a:hover {
    text-decoration-color: currentColor;
  }

  svg {
    fill: currentColor;
    flex: none;
  }

  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 10;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }
  .skip:focus {
    top: 12px;
  }

  /* La brújula de Inicio, mismo gesto: 260px, −8°, recortada en la esquina.
     Separada del borde superior: si lo tocara, Safari iOS muestrearía su verde
     y teñiría la barra de direcciones. */
  /* overflow-x del body se propaga al viewport y no evita que el móvil ensanche
     el layout viewport: el recorte va en un contenedor propio. */
  body {
    position: relative;
  }
  .deco-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .deco {
    position: absolute;
    top: 64px;
    right: -60px;
    width: 300px;
    height: 300px;
    fill: var(--deco);
    transform: rotate(-8deg);
    pointer-events: none;
    z-index: 0;
  }

  .top,
  .layout,
  .foot {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: max(16px, env(safe-area-inset-top));
    padding-bottom: 8px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 9px;
    background: var(--primary);
    color: #fff;
  }
  .brand__mark svg {
    width: 18px;
    height: 18px;
  }
  .brand__word {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .brand__word b {
    color: var(--primary);
  }

  /* El selector Ida / Vuelta de Recorrido, en la paleta neutra. */
  .seg {
    display: inline-flex;
    padding: 4px;
    gap: 4px;
    border-radius: 16px;
    background: var(--soft);
  }
  .seg a {
    min-width: 92px;
    height: 40px;
    display: grid;
    place-items: center;
    padding-inline: 16px;
    border-radius: 12px;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease-out;
  }
  .seg a:hover {
    color: var(--ink);
  }
  .seg a[aria-current='page'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow:
      0 1px 2px rgb(var(--shadow) / 0.08),
      0 4px 12px rgb(var(--shadow) / 0.06);
    view-transition-name: seg-thumb;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    padding-block: 40px 56px;
  }

  .intro h1 {
    margin: 0 0 14px;
    font-size: clamp(32px, 6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 700;
    text-wrap: balance;
    max-width: 14ch;
  }

  /* El chip "Recomendada" de Resultados. */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 6px 12px 6px 10px;
    border-radius: 99px;
    background: var(--accent-bg);
    color: var(--primary-deep);
    font-size: 13px;
    font-weight: 600;
  }
  .chip svg {
    width: 16px;
    height: 16px;
  }

  .toc details {
    background: var(--surface);
    border-radius: 22px;
    padding: 6px;
    box-shadow:
      0 1px 2px rgb(var(--shadow) / 0.06),
      0 10px 28px rgb(var(--shadow) / 0.07);
  }
  .toc summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 16px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
    list-style: none;
  }
  .toc summary::-webkit-details-marker {
    display: none;
  }
  .toc summary svg {
    width: 20px;
    height: 20px;
    color: var(--primary);
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 4px;
  }
  .toc li a {
    display: block;
    padding: 10px 12px 10px 42px;
    border-radius: 12px;
    color: var(--ink-3);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
  }
  .toc li a:hover {
    background: var(--soft);
    color: var(--ink);
  }

  .back {
    display: inline-block;
    margin-top: 20px;
    font-size: 13px;
  }
  @media (min-width: 960px) {
    .back {
      display: none;
    }
  }
  .doc {
    max-width: 60ch;
    outline: none;
  }
  .doc p,
  .doc ul {
    margin: 0 0 1em;
    color: var(--ink-3);
  }
  .doc ul {
    padding-left: 1.25em;
  }
  .doc li {
    margin-bottom: 0.4em;
  }
  .doc li::marker {
    color: var(--primary);
  }
  .lede p:first-child {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink);
    font-weight: 500;
  }
  .doc section {
    padding-top: 28px;
    margin-top: 28px;
    border-top: 1px solid var(--line);
  }
  .doc h2 {
    margin: 0 0 12px;
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 700;
    color: var(--ink);
    text-wrap: balance;
  }
  .doc h2:target {
    color: var(--primary-deep);
  }

  /* El banner de ubicación de Inicio: fondo menta, ícono verde, botón a la derecha. */
  .ask {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding: 16px;
    border-radius: 22px;
    background: var(--accent-bg);
  }
  .ask__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--primary);
  }
  .ask__icon svg {
    width: 22px;
    height: 22px;
  }
  .ask div {
    flex: 1 1 200px;
  }
  .ask p {
    margin: 0;
  }
  .ask__title {
    font-weight: 700;
    color: var(--ink);
  }
  .ask__text {
    font-size: 14px;
    color: var(--ink-2);
  }
  .ask__btn {
    padding: 11px 16px;
    border-radius: 12px;
    background: var(--primary);
    color: var(--on-primary);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 2px 8px rgb(24 35 29 / 0.16);
    transition: background-color 0.2s ease-out;
  }
  .ask__btn:hover {
    background: #23683f;
  }

  /* Holgura abajo para la barra flotante de Safari iOS (y la de gestos de
     Android): sin ella tapa el selector de idioma al llegar al final. */
  .foot {
    padding-bottom: calc(56px + env(safe-area-inset-bottom));
    font-size: 13px;
    color: var(--ink-2);
  }
  .foot p {
    margin: 0 0 4px;
  }
  .foot a {
    color: inherit;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 20px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .langs a {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding-inline: 14px;
    border-radius: 99px;
    background: var(--soft);
    color: var(--ink-3);
    font-weight: 600;
    text-decoration: none;
  }
  .langs a:hover {
    color: var(--ink);
  }
  .langs a[aria-current='page'] {
    background: var(--accent-bg);
    color: var(--primary-deep);
  }

  .courtesy {
    max-width: 52ch;
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* Compuestos largos (Nutzungsbedingungen, конфиденциальности): guion donde
     toca en vez de corte a mitad de palabra. En el cuerpo solo alemán y ruso;
     en español o inglés partiría palabras comunes sin necesidad. */
  h1,
  h2,
  :lang(de) body,
  :lang(ru) body {
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  /* Japonés: Montserrat no trae kanji. La cara del sistema (Hiragino en Apple,
     Noto CJK en Android) toma esos glifos; el latín sigue en Montserrat. */
  :lang(ja) body {
    font-family: 'Montserrat', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', 'Noto Sans CJK JP',
      'Yu Gothic', system-ui, sans-serif;
    line-height: 1.85;
    line-break: strict;
  }
  :lang(ja) h1,
  :lang(ja) h2 {
    letter-spacing: 0;
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: 260px minmax(0, 1fr);
      column-gap: 56px;
      row-gap: 40px;
      padding-top: 64px;
    }
    .intro {
      grid-column: 2;
    }
    .toc {
      grid-row: 1 / span 2;
      align-self: start;
      position: sticky;
      top: 24px;
    }
    .toc summary {
      pointer-events: none;
    }
    .doc {
      grid-column: 2;
      grid-row: 2;
    }
    .deco {
      width: 420px;
      height: 420px;
      right: -90px;
      top: 48px;
    }
  }

  /* Un solo momento: al cambiar de documento, el pulgar del selector se desliza. */
  @view-transition {
