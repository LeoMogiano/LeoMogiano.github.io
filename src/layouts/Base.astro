---
import type { Dict, Lang } from '../i18n';
import { langs, langPrefix } from '../i18n';
import { socials } from '../data/socials';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/icons.css';
import '../styles/global.css';

interface Props {
  lang: Lang;
  t: Dict;
}

const { lang, t } = Astro.props;

const META: Record<Lang, { title: string; description: string; ogDescription: string }> = {
  es: {
    title: 'Leo Mogiano — Tech Lead Mobile · iOS, Android y Flutter',
    description:
      'Portafolio de Leo Mogiano, Tech Lead Mobile en Datec Corp. Apps en producción con Flutter, Swift y Kotlin: EGX One, ValidMe, EGX Staff, Presto Latam y SkeletonPDF.',
    ogDescription:
      'Seis años construyendo apps móviles entre banca, fintech y herramientas internas.',
  },
  en: {
    title: 'Leo Mogiano — Mobile Tech Lead · iOS, Android and Flutter',
    description:
      "Leo Mogiano's portfolio, Mobile Tech Lead at Datec Corp. Apps in production with Flutter, Swift and Kotlin: EGX One, ValidMe, EGX Staff, Presto Latam and SkeletonPDF.",
    ogDescription: 'Six years building mobile apps across banking, fintech and internal tools.',
  },
  ja: {
    title: 'Leo Mogiano — モバイル・テックリード · iOS、Android、Flutter',
    description:
      'Datec Corp のモバイル・テックリード、Leo Mogiano のポートフォリオ。Flutter、Swift、Kotlin による本番アプリ：EGX One、ValidMe、EGX Staff、Presto Latam、SkeletonPDF。',
    ogDescription: '銀行、フィンテック、社内ツールを渡り歩いた6年間のモバイルアプリ開発。',
  },
};

const meta = META[lang];
const canonical = new URL(`${langPrefix(lang)}/`, Astro.site).href;

/* og:image tiene que ser absoluta: los rastreadores de X, LinkedIn y WhatsApp
   no resuelven rutas relativas. */
const ogImage = new URL('/og.jpg', Astro.site).href;

/* Datos estructurados. Es lo que le permite a Google entender que la página es
   una persona con un puesto y un empleador, en vez de texto suelto. */
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Leo Mogiano',
  url: canonical,
  image: ogImage,
  jobTitle: t.role,
  worksFor: { '@type': 'Organization', name: 'Datec Corp' },
  knowsAbout: ['Flutter', 'Swift', 'Kotlin', 'iOS', 'Android'],
  /* Derivado de socials.ts, no repetido: escrito a mano ya divergía —le
     faltaba la barra final del enlace de LinkedIn— y un `sameAs` que no
     coincide con el perfil real no le sirve a Google para vincularlos. */
  sameAs: socials.filter((s) => s.external).map((s) => s.href),
  email: socials.find((s) => s.href.startsWith('mailto:'))?.href,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content="Leo Mogiano" />

    {/*
      Sin <meta theme-color> a propósito: con él, Safari iOS pinta la barra
      superior de un color sólido que no coincide con el header translúcido y
      deja una costura visible. Sin él, muestrea el borde del viewport (el
      background de <html>) y la tiñe de forma continua.
    */}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* iOS ignora los favicon SVG: para la pantalla de inicio hace falta PNG. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {
      langs.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(`${langPrefix(l)}/`, Astro.site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.code.replace('-', '_')} />
    <meta property="og:site_name" content="Leo Mogiano" />
    {/* Sin esto, `summary_large_image` prometía una imagen que no existía y la
        tarjeta salía sin nada al compartir el enlace. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="256" />
    <meta property="og:image:height" content="242" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    {/* `summary` y no `summary_large_image`: la imagen es casi cuadrada, y la
        tarjeta grande la recortaría a 1.91:1 comiéndose media cara. Así se
        dibuja la tarjeta compacta —miniatura a la izquierda, título y
        descripción al lado—, que es la que se pidió. */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.ogImageAlt} />

    {/* Las dos caras visibles en el primer viewport. El resto va con swap. */}
    <link
      rel="preload"
      href="/fonts/instrument-serif-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/dm-sans-var.woff2" as="font" type="font/woff2" crossorigin />

    {/*
      Bloqueante a propósito: pinta el tema guardado antes del primer frame.
      Diferirlo significa un flash blanco al recargar en modo claro.
    */}
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          const saved = localStorage.getItem('lm-theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch {}
        document.documentElement.dataset.t = theme;
      })();
    </script>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personLd)}
    />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
