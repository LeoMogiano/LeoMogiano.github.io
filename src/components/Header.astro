---
import Icon from './ui/Icon.astro';
import Counter from './Counter.astro';
import Pill from './ui/Pill.astro';
import { nav } from '../data/nav';
import { nextLang, langPrefix } from '../i18n';
import type { Lang, Dict } from '../i18n';

interface Props {
  lang: Lang;
  t: Dict;
}

const { lang, t } = Astro.props;
const langHref = langPrefix(nextLang(lang)) + '/';
const cvHref = `/cv/leo-mogiano-cv-${t.code.slice(0, 2)}.pdf`;
---

<header class="header">
  <div class="header__brand">
    <span class="header__name">Leo Mogiano</span>
    <span class="header__meta">
      <span class="header__role">{t.role}</span>
      <span class="header__clock" title={t.clockTitle}>
        <span class="header__flag">🇧🇴</span><time class="clock" datetime="">--:--</time>
      </span>
      <Counter t={t} />
    </span>
  </div>
  <nav class="header__nav">
    {nav.map((item, i) => (
      <Pill
        as="a"
        variant="default"
        class="nav__link"
        href={'#' + item.id}
        data-nav-link
        data-haptic
        data-section={item.id}
      >
        <Icon name={item.icon} size="14px" />
        <span class="nav__label">{t.nav[i]}</span>
      </Pill>
    ))}
    <Pill
      as="a"
      variant="card"
      icon="file-down"
      class="header__cv"
      href={cvHref}
      target="_blank"
      rel="noopener"
      aria-label={t.cvAria}
    >
      {t.cvLabel}
    </Pill>
    <a
      class="header__lang"
      href={langHref}
      aria-label={`${t.langAria}: ${t.langNext}`}
      title={t.langNext}
      data-lang-link
      data-haptic
    >
      {t.langLabel}
    </a>
    <button
      type="button"
      class="header__theme"
      data-theme-toggle
      data-haptic
      aria-label={t.themeAria}
      title={t.themeAria}
    >
      <span class="header__theme-icon header__theme-icon--sun"><Icon name="sun" size="17px" /></span>
      <span class="header__theme-icon header__theme-icon--moon"><Icon name="moon" size="17px" /></span>
    </button>
  </nav>
</header>

{/* Barra compacta solo con la cabecera fuera de vista y sin espacio para el
    nav completo: nombre, CV y contacto. Oculta con visibility para que no
    reciba foco mientras no se ve. */}
<div class="bar" data-bar>
  <a class="bar__name" href="#top">Leo Mogiano</a>
  <Pill as="a" variant="active" icon="file-down" href={cvHref} target="_blank" rel="noopener" aria-label={t.cvAria}>
    {t.cvLabel}
  </Pill>
  <Pill as="a" variant="card" class="bar__contact" href="#hello" aria-label={t.nav[4]} title={t.nav[4]} data-haptic>
    <Icon name="send" size="16px" />
  </Pill>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-bar]');
  const header = document.querySelector('.header');
  if (bar && header) {
    new IntersectionObserver(([e]) => bar.classList.toggle('is-on', !e!.isIntersecting)).observe(header);
  }
</script>

<style>
  /* Sticky solo en escritorio; en móvil lo reemplaza .bar (más abajo). Safari
     26 saca el color de su barra del elemento fijo pegado al borde superior,
     así que el fondo es el de --bg, translúcido, y no un color propio. */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 5vw;
    background: transparent;
    /* Solo la línea, sin fondo ni blur: lo que teñía la barra de estado de
       Safari era el relleno pegado al borde superior del viewport, y esto va
       en el borde de abajo. Más suave que el resto de divisores del sitio —
       separa de lo que scrollea debajo sin dibujar una franja. */
    border-bottom: 1px solid color-mix(in oklab, var(--line) 60%, transparent);
  }

  @media (min-width: 1041px) {
    .header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: color-mix(in oklab, var(--bg) 82%, transparent);
      backdrop-filter: blur(14px);
    }
  }

  .bar {
    display: none;
  }

  @media (max-width: 1040px) {
    :global(.header__cv.pill) {
      display: none;
    }

    .bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 5vw;
      background: color-mix(in oklab, var(--bg) 88%, transparent);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
      transform: translateY(-100%);
      visibility: hidden;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s 0.35s;
    }

    .bar.is-on {
      transform: none;
      visibility: visible;
      transition-delay: 0s;
    }

    .bar__name {
      flex: 1;
      font-family: var(--display);
      font-size: 20px;
      letter-spacing: 0.045em;
      color: var(--fg);
      text-decoration: none;
    }

    :global(.bar__contact.pill) {
      padding: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar {
      transition: none;
    }
  }

  .header__brand {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .header__name {
    font-family: var(--display);
    font-size: 23px;
    letter-spacing: 0.045em;
    line-height: 1.1;
    word-spacing: 0.06em;
  }

  .header__meta {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 3px;
  }

  .header__role {
    font-family: var(--label);
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .header__clock {
    font-family: var(--label);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--fs-label);
    letter-spacing: 0.1em;
    color: var(--faint);
    border-left: 1px solid var(--line);
    padding-left: 9px;
  }

  .header__flag {
    font-size: var(--fs-meta);
    line-height: 1;
  }

  .clock {
    min-width: 5ch;
  }

  .header__nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }

  /* El scrollspy en cliente añade/quita esta clase sobre el <a> del nav. */
  .nav__link.is-active,
  .nav__link.is-active:hover {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .header__lang {
    position: relative;
    cursor: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    width: 38px;
    flex: none;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--fg);
    font-family: var(--label);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  .header__lang::after,
  .header__theme::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }

  @media (hover: hover) and (pointer: fine) {
    .header__lang:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  .header__theme {
    position: relative;
    cursor: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--card);
    color: var(--fg);
    padding: 0;
    font: inherit;
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .header__theme:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  /* Sol por defecto (tema oscuro), luna cuando html[data-t="light"]. */
  .header__theme-icon {
    display: flex;
  }

  .header__theme-icon--moon {
    display: none;
  }

  :global(html[data-t='light']) .header__theme-icon--sun {
    display: none;
  }

  :global(html[data-t='light']) .header__theme-icon--moon {
    display: flex;
  }

  @media (max-width: 1040px) {
    .header {
      padding: 12px 5vw;
    }

    .header__nav {
      gap: 4px;
    }

    /* El rol ya aparece bajo el retrato. En pantallas estrechas ocupaba hasta
       tres líneas en japonés y estiraba la cabecera; se queda solo el reloj. */
    .header__role {
      display: none;
    }

    /* Sin el rol delante, el reloj ya no separa nada. El contador sí: sigue
       yendo detrás del reloj. */
    .header__clock {
      border-left: 0;
      padding-left: 0;
    }

    :global(.nav__link.pill) {
      padding: 9px 11px;
    }

    .nav__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
