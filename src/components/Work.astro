---
import type { Lang, Dict } from '../i18n';
import { Image } from 'astro:assets';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import PhoneFrame from './ui/PhoneFrame.astro';
import { apps } from '../data/apps';
import { appCopy } from '../i18n/apps';

interface Props {
  lang: Lang;
  t: Dict;
}

const { lang, t } = Astro.props;

// El teléfono arranca mostrando la primera app; el resto de estados
// vive en el DOM desde el inicio y el CSS decide cuál se ve.
const defaultApp = apps[0].num;

/*
 * Las capturas no pasan por <Image>: sus URLs se guardan en data-src para
 * decidir nosotros cuándo se piden. Con loading="lazy" no
 * alcanza: el umbral de Chrome llega a unos 3000 px y el teléfono está a 1900
 * del inicio, así que cuatro de las cinco se descargaban —250 KB— en la carga
 * de la portada, para alguien que quizá nunca baja hasta aquí.
 *
 * Solo viaja en el HTML la primera captura de la app que el teléfono muestra
 * al cargar. Las demás las pide src/scripts/app-shots.ts: las de la misma app,
 * al primer gesto sobre el carrusel; las de las otras, cuando se las elige.
 */
/*
 * Se usa `shot.src` del propio import en vez de getImage(). Con el servicio de
 * imagen en `noop` las dos rutas devuelven el mismo archivo, pero cada una lo
 * emite con su hash: quedaban 21 capturas duplicadas —844 KB de los 1949 que
 * pesaban las imágenes del build— y las del import no las referenciaba nadie.
 *
 * Tampoco hace falta srcset: prepare-assets.mjs ya deja las capturas a 564px,
 * que sobre los ~282px CSS de la pantalla del teléfono es exactamente 2x. El
 * srcset anterior anunciaba 300w y 600w sobre dos archivos de 564px los dos.
 */
const shotSources = apps
  .filter((app) => app.shots?.length)
  .map(
    (app) =>
      [
        app.num,
        app.shots!.map((shot, i) => ({
          src: shot.src,
          height: Math.round((300 * shot.height) / shot.width),
          /*
           * La de 1170 px no se pide aquí: su URL viaja en un data- y el visor
           * a pantalla completa la usa al abrirse. Son 30–190 KB por captura y
           * en el teléfono no se distinguirían de la chica.
           */
          full: app.shotsFull?.[i]?.src,
        })),
      ] as const,
  );
const shotsByApp = new Map(shotSources);
---

<section id="work" data-app-current={defaultApp}>
  <SectionHeader num={1} label={t.workBadge} aria={t.sectionAria} gap="44px">
    <h2>{t.workA}<em>{t.workEm}</em>{t.workB}</h2>
  </SectionHeader>

  <div class="work__grid">
    <div class="work__phone-slot">
      <PhoneFrame width="min(300px,84vw)" screen="card">
        <div class="phone__status">
          <span>9:41</span>
          <span class="phone__signals">
            <Icon name="signal" size="11px" />
            <Icon name="wifi" size="11px" />
            100
            <Icon name="battery" size="17px" />
          </span>
        </div>
        <div class="phone__body">
          <span class="phone__icons">
            {apps.map((app) => (
              <Image
                src={app.icon}
                alt={`Icono de ${app.name}`}
                width={96}
                height={96}
                data-app-icon={app.num}
                class="phone__icon"
              />
            ))}
          </span>
          {apps.map((app) => {
            const copy = appCopy[lang][app.num];
            return (
              <div class="phone__panel" data-app-panel={app.num}>
                <div>
                  <div class="phone__name">{app.name}</div>
                  <div class="phone__tag">{copy.tag}</div>
                </div>
                <p class="phone__desc">{copy.desc}</p>
                <div class="phone__meta">
                  <span>{app.year}</span><span>{copy.role}</span>
                </div>
              </div>
            );
          })}
        </div>

        {apps.filter((app) => app.shots?.length).map((app) => (
          <div class="phone__shots" data-app-shots={app.num} data-app-label={app.name}>
            <div
              class="phone__track"
              data-shots-track
              role="region"
              aria-label={t.shotsAria.replace('{app}', app.name)}
              tabindex="0"
            >
              {(shotsByApp.get(app.num) ?? []).map((shot, i) => (
                <div class="phone__slide" data-shots-slide>
                  <img
                    src={i === 0 && app.num === defaultApp ? shot.src : undefined}
                    data-shot-src={i === 0 && app.num === defaultApp ? undefined : shot.src}
                    data-shot-full={shot.full}
                    width="300"
                    height={shot.height}
                    alt={t.shotAlt.replace('{app}', app.name).replace('{n}', String(i + 1))}
                    loading="lazy"
                    decoding="async"
                    class="phone__shot"
                  />
                </div>
              ))}
            </div>
            <div class="phone__dots" data-shots-dots>
              {app.shots!.map((_, i) => (
                <button
                  type="button"
                  class="phone__dot"
                  data-shots-dot={i}
                  data-haptic
                  aria-label={t.shotGo.replace('{app}', app.name).replace('{n}', String(i + 1))}
                  aria-current={i === 0 ? 'true' : 'false'}></button>
              ))}
            </div>

            {/* Solo en móvil. En escritorio la pantalla del teléfono ya es tan
                grande como la ventana permite y el botón sería un adorno; en un
                viewport de 390 px la captura mide 282 y se lee a medias. */}
            <button
              type="button"
              class="phone__expand"
              data-shots-open
              data-haptic
              aria-label={t.shotOpen.replace('{app}', app.name)}
            >
              <Icon name="expand" size="14px" />
            </button>
          </div>
        ))}
      </PhoneFrame>

      {/* Selector compacto, solo cuando la rejilla se apila. Ahí el teléfono
          mide 628 px de alto y la lista queda debajo: sin esto tocas una fila
          y el resultado cambia fuera de pantalla. Reusa data-app-pick, que
          app-picker.ts ya engancha para cualquier botón de la sección. */}
      <div class="work__picker" role="group" aria-label={t.appPickerAria}>
        {apps.map((app) => (
          <button
            type="button"
            class="work__pick"
            data-app-pick={app.num}
            data-haptic
            aria-pressed={app.num === defaultApp}
          >
            <Image src={app.icon} alt="" width={96} height={96} class="work__pick-icon" />
            {/* app-picker.ts lee el nombre del primer botón que coincide para
                anunciar el cambio, y estos van antes que la lista en el DOM. */}
            <span class="sr-only" data-app-name>{app.name}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="work__list">
      {apps.map((app) => {
        const copy = appCopy[lang][app.num];
        return (
          <button type="button" data-app-pick={app.num} aria-pressed={app.num === apps[0]?.num} class="slide-row work__item" data-haptic>
            <Image
              src={app.icon}
              alt=""
              width={96}
              height={96}
              class="work__icon"
            />
            <span>
              <span class="work__name" data-app-name>{app.name}</span>
              <span class="work__short">{copy.short}</span>
            </span>
            <span class="work__tag">{copy.tag}</span>
          </button>
        );
      })}
      <p class="work__note">{t.workNote}</p>
    <p class="sr-only" role="status" aria-live="polite" data-app-status data-app-status-label={t.appSelected}></p>
    </div>
  </div>

  {/*
   * El visor a pantalla completa. Uno solo para las cinco apps: las diapositivas
   * las arma shots-fullscreen.ts al abrirlo, leyendo las capturas de la app que
   * el teléfono esté mostrando. Cinco visores en el HTML serían 21 <img> que en
   * escritorio no se abren nunca.
   *
   * No usa la Fullscreen API. En iPhone no existió para elementos que no fueran
   * <video> hasta Safari 26, y aun donde existe el navegador pinta su propia
   * barra de salir encima y se queda con el gesto de cierre. Un <dialog> modal
   * ocupa el mismo viewport, y el swipe hacia abajo y la transición siguen
   * siendo nuestros. De regalo trae foco atrapado y Escape.
   */}
  <dialog
    class="shotsfs"
    data-shots-full
    data-label={t.shotsFullAria}
    data-go={t.shotGo}
  >
    <div class="shotsfs__track" data-shotsfs-track></div>
    <div class="shotsfs__dots" data-shotsfs-dots></div>
    <button
      type="button"
      class="shotsfs__close"
      data-shotsfs-close
      data-haptic
      aria-label={t.shotClose}
    >
      <Icon name="x" size="17px" />
    </button>
  </dialog>
</section>

<style>
  #work {
    position: relative;
    padding: 6vh 5vw;
    border-bottom: 1px solid var(--line);
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .work__phone-slot {
    justify-self: center;
    max-width: 100%;
  }

  /*
   * Oculto mientras la rejilla tiene dos columnas: ahí el teléfono y la lista
   * se ven a la vez y el selector sobra. El corte sale de la propia rejilla
   * —minmax(300px, 1fr) con gap de 5vw sobre un ancho de 90vw entran dos
   * columnas a partir de ~706 px— y no de un breakpoint inventado.
   */
  .work__picker {
    display: none;
  }

  /*
   * Apilado, el tag deja de robarle ancho a la descripción. Con `auto` y
   * `white-space: nowrap` reservaba ~120 px fijos en la misma fila, y a 390 px
   * de viewport a la descripción le quedaban ~125: partía cada dos palabras
   * con media pantalla vacía al lado. Bajándolo a su propia línea, el texto
   * pasa a ~270.
   */
  @media (max-width: 705px) {
    .work__item {
      /*
       * La fila deja de responder al dedo. Con el teléfono a 628px de alto
       * encima de la lista, tocarla cambiaba una app cuyo resultado quedaba
       * fuera de pantalla, y al recorrer la lista se activaba sin querer. El
       * selector de iconos bajo el teléfono ya cubre ese trabajo, y ahí sí se
       * ve lo que cambia.
       *
       * Solo puntero: el botón sigue existiendo, así que el teclado y la
       * activación de VoiceOver lo siguen alcanzando.
       */
      pointer-events: none;
      grid-template-columns: var(--icon) 1fr;
      /* `gap: 24px` valía para una sola fila; entre las dos nuevas es demasiado. */
      row-gap: 10px;
    }

    /* El icono cruza las dos filas para seguir centrado contra el bloque
       entero, como estaba, en vez de contra el texto solo. */
    :global(.work__icon) {
      grid-row: 1 / -1;
    }

    .work__tag {
      grid-column: 2;
    }
  }

  @media (max-width: 705px) {
    .work__picker {
      display: flex;
      justify-content: center;
      gap: 4px;
      margin-top: 20px;
    }
  }

  /* El padding lleva el área táctil a 44 px sin agrandar el icono. */
  .work__pick {
    cursor: none;
    display: inline-flex;
    padding: 9px;
    border: 0;
    background: none;
  }

  /*
   * La opacidad va en el icono, no en el botón: `opacity` se aplica también al
   * outline, y con 0.32 en el botón el anillo de :focus-visible se pintaba al
   * 32% en los cuatro no seleccionados. Un indicador de foco tiene que ser
   * visible (WCAG 2.4.11).
   *
   * Aquí sí vale atenuar porque son imágenes. En .work__item se evita a
   * propósito: multiplicar el alfa del texto lo dejaba en 2.9:1.
   */
  :global(.work__pick-icon) {
    display: block;
    width: 34px;
    height: 34px;
    border-radius: 25%;
    opacity: 0.32;
    transition: opacity 0.3s ease;
  }

  .work__pick[aria-pressed='true'] :global(.work__pick-icon) {
    opacity: 1;
  }

  /* --- pantalla del teléfono --- */

  .phone__status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* Centrada con la isla, igual que la barra que traen las capturas. */
    padding: 11px 22px 0;
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--dim);
    /* Encima de las capturas: la barra de estado es del aparato, no de la app.
       A las capturas se les recortó la suya en prepare-assets. */
    position: relative;
    z-index: 4;
  }

  /* La captura trae su propia barra de estado, con su reloj y sus iconos. Dos
     barras a la vez delatan el montaje, así que manda la de la app. Hoy las
     cinco tienen capturas; se enumeran igual que el resto de reglas del
     archivo, para que quitarle las capturas a una sea borrar su línea. */
  [data-app-current='01'] .phone__status,
  [data-app-current='02'] .phone__status,
  [data-app-current='03'] .phone__status,
  [data-app-current='04'] .phone__status,
  [data-app-current='05'] .phone__status {
    visibility: hidden;
  }

  /*
   * El home indicator del marco se apaga donde la captura trae el suyo, o se
   * verían dos barras juntas. No es toda app con capturas: `cover` recorta
   * unos pocos píxeles por abajo y algunas pantallas —la portada de EGX One,
   * el ingreso de EGX Staff— nunca lo tuvieron dibujado. Ahí lo pone el marco,
   * que para eso es un teléfono.
   *
   * La variable la lee PhoneFrame; viaja por herencia desde aquí.
   */
  [data-app-current='02'] .work__phone-slot,
  [data-app-current='04'] .work__phone-slot,
  [data-app-current='05'] .work__phone-slot {
    --indicator: 0;
  }

  /* Cobertura, wifi y batería son iconos, no glifos: el subset latin de DM Sans
     no trae ▮ ni ᯤ, así que caían al font del sistema y en Windows y Android
     salían como cuadros vacíos. */
  .phone__signals {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }


  .phone__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 26px 24px 40px;
    text-align: center;
    position: relative;
  }

  .phone__icons {
    position: relative;
    width: 96px;
    height: 96px;
    display: block;
  }

  .phone__icon {
    position: absolute;
    inset: 0;
    width: 96px;
    height: 96px;
    border-radius: 24px;
    object-fit: cover;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* solo el estado activo se ve; el resto queda fuera de flujo y sin foco */
  .phone__panel {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  [data-app-current='01'] .phone__icon[data-app-icon='01'],
  [data-app-current='02'] .phone__icon[data-app-icon='02'],
  [data-app-current='03'] .phone__icon[data-app-icon='03'],
  [data-app-current='04'] .phone__icon[data-app-icon='04'],
  [data-app-current='05'] .phone__icon[data-app-icon='05'] {
    opacity: 1;
  }

  [data-app-current='01'] .phone__panel[data-app-panel='01'],
  [data-app-current='02'] .phone__panel[data-app-panel='02'],
  [data-app-current='03'] .phone__panel[data-app-panel='03'],
  [data-app-current='04'] .phone__panel[data-app-panel='04'],
  [data-app-current='05'] .phone__panel[data-app-panel='05'] {
    opacity: 1;
    visibility: visible;
    position: relative;
  }

  .phone__name {
    font-family: var(--appfont);
    font-style: var(--appstyle);
    letter-spacing: var(--apptrack);
    text-transform: var(--appcase);
    font-size: 26px;
    line-height: 1.15;
  }

  .phone__tag {
    font-family: var(--label);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 8px;
  }

  .phone__desc {
    margin: 0;
    font-size: 12px;
    line-height: 1.85;
    letter-spacing: 0.015em;
    color: var(--dim);
    text-wrap: pretty;
  }

  .phone__meta {
    width: 100%;
    border-top: 1px solid var(--line);
    padding-top: 14px;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  /* --- capturas reales dentro de la pantalla --- */

  /* Van encima de la ficha, tapando también la barra de estado: la captura
     trae la suya, y dos barras a la vez delatarían el montaje. La isla y el
     home indicator del marco quedan por encima (z-index 3). */
  .phone__shots {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease;
    /* Negro de bisel en toda la capa, no solo en cada slide: el hueco de
       subpíxel puede caer entre dos slides o al final del track, donde el
       fondo del slide ya no llega y asomaba la pantalla, beige en tema
       claro. */
    background: #08080a;
  }

  [data-app-current='01'] .phone__shots[data-app-shots='01'],
  [data-app-current='02'] .phone__shots[data-app-shots='02'],
  [data-app-current='03'] .phone__shots[data-app-shots='03'],
  [data-app-current='04'] .phone__shots[data-app-shots='04'],
  [data-app-current='05'] .phone__shots[data-app-shots='05'] {
    opacity: 1;
    visibility: visible;
  }

  /* El carrusel es un scroller nativo con scroll-snap: el gesto táctil, el
     scroll horizontal del trackpad y las flechas del teclado ya funcionan sin
     una línea de JS. El script solo lo avanza solo y sincroniza los puntos. */
  .phone__track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* Al llegar al final del carrusel el gesto no debe seguir de largo y
       arrastrar la página. */
    overscroll-behavior-x: contain;
  }

  .phone__track::-webkit-scrollbar {
    display: none;
  }

  .phone__track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .phone__slide {
    flex: none;
    width: 100%;
    height: 100%;
    overflow: hidden;
    scroll-snap-align: center;
    /* Red de seguridad del mismo problema: si algún día vuelve a faltar un
       subpíxel, que lo que asome sea negro de bisel y no fondo de página. */
    background: #08080a;
  }

  /*
   * Ancho exacto y anclada arriba. Hubo una versión con la imagen al 104% para
   * hacer parallax, y se veía mal: `cover` paga ese ancho de más recortando 14
   * px por arriba, y la barra de estado de la captura terminaba pisando la
   * Dynamic Island. La sensación de carrusel la dan la curva y la inercia del
   * script, que no tocan la geometría.
   */
  .phone__shot {
    /*
     * Un píxel de más por la derecha y por abajo, que el slide recorta. La
     * pantalla mide 293.4 x 628.2 y el navegador redondea la imagen a enteros:
     * quedaba una fracción de píxel sin cubrir por la que asomaba el fondo de
     * la pantalla, blanco en el tema claro. Se veía como una raya.
     */
    width: calc(100% + 1px);
    height: calc(100% + 1px);
    object-fit: cover;
    object-position: top;
    /* Sin esto, arrastrar el carrusel con el mouse arranca el drag&drop del
       navegador: aparece el fantasma de la imagen y el gesto se pierde. */
    user-select: none;
    -webkit-user-drag: none;
  }

  /*
   * Escondidos salvo cuando dicen algo. Sobre la captura, cinco puntos fijos
   * son un adorno que tapa la app; aparecen al cambiar de captura, al
   * arrastrar, al pasar por encima y al recibir foco, y se van solos.
   *
   * pointer-events se apaga con ellos: un botón invisible que igual se puede
   * pulsar es peor que no tenerlo.
   */
  .phone__dots {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    /* Justo encima del home indicator del marco, sin pisarlo. */
    bottom: 16px;
    display: flex;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 999px;
    /* La captura de abajo es impredecible: sin este fondo los puntos
       desaparecen sobre un fondo claro. */
    background: rgba(0, 0, 0, 0.35);
  }

  /* El desenfoque va solo mientras se ven: un backdrop-filter permanente
     obliga a componer el fondo en cada frame del carrusel, incluso con los
     puntos invisibles. */
  .phone__dots[data-visible],
  .phone__dots:focus-within {
    opacity: 1;
    pointer-events: auto;
    backdrop-filter: blur(6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .phone__dots {
      transition: none;
    }
  }

  .phone__dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: none;
    border-radius: 50%;
    cursor: none;
    background: rgba(255, 255, 255, 0.4);
    transition: background 0.25s ease;
  }

  .phone__dot[aria-current='true'] {
    background: #fff;
  }

  /* --- botón de pantalla completa --- */

  /*
   * Solo bajo 705px, el mismo corte donde aparece el selector de iconos. Arriba
   * de eso el teléfono ya está a su tamaño máximo y el botón sería un adorno
   * que tapa la captura.
   *
   * A diferencia de los puntos, este no se esconde: en táctil no hay hover que
   * lo revele, y un control que solo aparece después de arrastrar no lo
   * encuentra nadie.
   */
  .phone__expand {
    display: none;
  }

  @media (max-width: 705px) {
    .phone__expand {
      /* La caja es de 44 para el dedo; el círculo que se ve lo pinta ::before a
         30. Agrandar el botón entero taparía media captura. */
      position: absolute;
      right: 3px;
      bottom: 8px;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      background: none;
      color: #fff;
      cursor: none;
    }
  }

  .phone__expand::before {
    content: '';
    position: absolute;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    /* La captura de abajo es impredecible: sin fondo el icono desaparece sobre
       una pantalla clara. Mismo par que los puntos. */
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(6px);
  }

  .phone__expand :global(.icon) {
    position: relative;
  }

  /* --- visor a pantalla completa --- */

  /*
   * Un <dialog> trae borde, padding y un max-width/height de su propio antojo.
