---
import type { Dict } from '../i18n';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import Pill from './ui/Pill.astro';
import PhoneFrame from './ui/PhoneFrame.astro';

interface Props { t: Dict }
const { t } = Astro.props;
---

<section id="play">
  <div>
    <SectionHeader icon="badge-play" badge={t.playBadge} gap="26px">
      <h2>iOS <em>{t.vs}</em> Android 🏓</h2>
    </SectionHeader>
    <p class="play__p">{t.playP}</p>
    <div class="play__legend">
      <span class="play__legend-item">
        <span class="play__swatch play__swatch--you"></span>
        <Icon name="ios" size="14px" />{t.youIOS}
      </span>
      <span class="play__legend-item">
        <span class="play__swatch play__swatch--cpu"></span>
        <Icon name="android" size="14px" />{t.cpuAndroid}
      </span>
    </div>
    <p id="pong-help" class="sr-only">{t.pongHelp}</p>
    <Pill as="button" variant="card" icon="reset" class="play__reset" type="button" data-pong-reset>{t.resetBtn}</Pill>
  </div>
  <div class="play__phone">
    <PhoneFrame width="min(280px,80vw)" aspect="280/575" radius="48px" innerRadius="39px" screen="solid">
      <canvas
          class="pong"
          data-pong
          tabindex="0"
          role="application"
          aria-label={t.pongAria}
          aria-describedby="pong-help"></canvas>
      <div class="play__notch"></div>
      <div class="play__gesture-bar"></div>
    </PhoneFrame>
  </div>
</section>

<style>
  #play {
    padding: 9vh 5vw;
    border-bottom: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(30px, 6vw, 80px);
    align-items: center;
  }

  .play__p {
    margin: 0 0 26px;
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: .012em;
    color: var(--dim);
    max-width: 42ch;
    text-wrap: pretty;
  }

  .play__legend {
    font-family: var(--label);
    display: flex;
    gap: 26px;
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .play__legend-item {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .play__swatch {
    width: 20px;
    height: 6px;
    border-radius: 3px;
    display: block;
  }

  .play__swatch--you {
    background: var(--fg);
  }

  .play__swatch--cpu {
    background: var(--accent);
  }

  :global(.play__reset) {
    margin-top: 28px;
  }

  .play__phone {
    justify-self: center;
  }

  .pong {
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
    cursor: none;
  }

  .play__notch {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 22px;
    border-radius: 999px;
    /* El notch tapa el canvas, así que va del color del fondo, no negro fijo. */
    background: var(--bg);
    z-index: 3;
  }

  .play__gesture-bar {
    position: absolute;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%);
    width: 100px;
    height: 5px;
    border-radius: 3px;
    background: color-mix(in oklab, var(--fg) 45%, transparent);
    z-index: 3;
    pointer-events: none;
  }
</style>
