---
import { Image } from 'astro:assets';
import SectionHeader from './ui/SectionHeader.astro';
import { jobs } from '../data/jobs';
import { formatDuration, rangeParts } from '../i18n/dates';
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;

/* El tramo de la empresa va del inicio del rol más antiguo al fin del más
   reciente. Los roles vienen del más nuevo al más viejo. */
const spanOf = (job: (typeof jobs)[number]) => ({
  start: job.roles[job.roles.length - 1].start,
  end: job.roles[0].end,
});
---

<section id="path" class="path">
  <SectionHeader num={2} label={t.pathBadge} aria={t.sectionAria}>
    <h2>{t.pathA}<em>{t.pathEm}</em>{t.pathB}</h2>
  </SectionHeader>

  <div class="path__list">
    {
      jobs.map((job) => (
        <div class={`slide-row path__row ${job.roles.length > 1 ? 'path__row--multi' : 'path__row--single'}`}>
          {job.roles.length > 1 && (
            <div class="path__dur path__dur--floating">{formatDuration(spanOf(job), t)}</div>
          )}
          <Image src={job.logo} alt={job.company} width={60} height={60} class="path__logo" />
          {job.roles.length > 1 ? (
            <div class="path__body">
              <span class="path__company">{job.company}</span>
              <div class="path__roles">
                {job.roles.map((role, ri) => (
                  <>
                    <span class="path__dot-cell">
                      {ri === 0 && <span class="path__line" />}
                      <span class={`path__dot ${ri === 0 ? 'path__dot--accent' : 'path__dot--line'}`} />
                    </span>
                    <div class="path__role-row">
                      <span class={`path__role-name ${ri === 0 ? 'path__role-name--accent' : 'path__role-name--dim'}`}>
                        {t[role.roleKey as keyof Dict] as string}
                      </span>
                      <span class={`path__role-date ${ri === 0 ? 'path__role-date--primary' : 'path__role-date--secondary'}`}>
                        <time datetime={rangeParts(role, t).from.iso}>{rangeParts(role, t).from.label}</time>
                        {' — '}
                        {rangeParts(role, t).to.iso
                          ? <time datetime={rangeParts(role, t).to.iso}>{rangeParts(role, t).to.label}</time>
                          : rangeParts(role, t).to.label}
                      </span>
                    </div>
                  </>
                ))}
              </div>
            </div>
          ) : (
            <div class="path__body">
              <div class="path__role-name path__role-name--accent path__role-name--single">
                {t[job.roles[0].roleKey as keyof Dict] as string}
              </div>
              <div class="path__at">@ {job.company}</div>
            </div>
          )}
          {job.roles.length === 1 && (
            <div class="path__aside">
              <div class="path__role-date path__role-date--primary path__role-date--single">
                <time datetime={rangeParts(job.roles[0], t).from.iso}>{rangeParts(job.roles[0], t).from.label}</time>
                {' — '}
                {rangeParts(job.roles[0], t).to.iso
                  ? <time datetime={rangeParts(job.roles[0], t).to.iso}>{rangeParts(job.roles[0], t).to.label}</time>
                  : rangeParts(job.roles[0], t).to.label}
              </div>
              <div class="path__dur">{formatDuration(spanOf(job), t)}</div>
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .path {
    position: relative;
    padding: 9vh 5vw;
    border-bottom: 1px solid var(--line);
  }

  .path__list {
    display: flex;
    flex-direction: column;
  }

  .path__row {
    position: relative;
    display: flex;
    gap: clamp(16px, 2.4vw, 28px);
    border-top: 1px solid var(--line);
    padding: 20px clamp(10px, 1.6vw, 20px);
  }

  .path__list > .path__row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .path__row--multi {
    align-items: flex-start;
    padding: 24px clamp(10px, 1.6vw, 20px);
  }

  .path__row--single {
    align-items: center;
  }

  .path__dur {
    font-family: var(--label);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 10px;
    white-space: nowrap;
  }

  .path__dur--floating {
    position: absolute;
    top: 24px;
    right: clamp(10px, 1.6vw, 20px);
  }

  .path__dur:not(.path__dur--floating) {
    display: inline-block;
    margin-top: 8px;
  }

  :global(.path__logo) {
    width: clamp(46px, 5vw, 60px);
    height: clamp(46px, 5vw, 60px);
    flex: none;
    border-radius: 14px;
  }

  .path__body {
    flex: 1;
    min-width: 0;
  }

  .path__company {
    font-size: clamp(17px, 2.2vw, 24px);
    letter-spacing: 0.015em;
    line-height: 1.3;
  }

  .path__roles {
    margin: 18px 0 0;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    row-gap: 16px;
    font-size: clamp(15px, 1.8vw, 20px);
  }

  .path__dot-cell {
    position: relative;
    display: block;
  }

  /*
   * El punto se ancla en `em` (no en px) para seguir el centro de la
   * primera línea del rol cuando este se parte en dos líneas en móvil.
   */
  .path__dot {
    position: absolute;
    left: 0;
    top: 0.32em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--bg);
  }

  .path__dot--accent {
    background: var(--accent);
  }

  .path__dot--line {
    background: var(--line);
  }

  .path__line {
    position: absolute;
    left: 3.5px;
    top: calc(0.32em + 4.5px);
    width: 2px;
    height: calc(100% + 16px);
    border-radius: 2px;
    background: linear-gradient(to bottom, var(--accent), var(--line));
    pointer-events: none;
  }

  .path__role-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    align-items: baseline;
  }

  .path__role-name {
    flex: 1;
    min-width: 0;
    font-size: 1em;
    letter-spacing: 0.015em;
  }

  .path__role-name--single {
    font-size: clamp(17px, 2.2vw, 24px);
    line-height: 1.3;
  }

  .path__role-name--accent {
    color: var(--accent);
  }

  .path__role-name--dim {
    color: var(--dim);
  }

  .path__at {
    color: var(--dim);
    font-size: 13px;
    margin-top: 6px;
    letter-spacing: 0.04em;
  }

  .path__role-date {
    flex: none;
    text-align: right;
    font-size: 13px;
    /* DM Sans es variable (100–1000) y ya está descargada: el peso sale gratis.
       La fecha es el dato del que la duración se deriva, así que es la que
       aguanta el peso. */
    font-weight: 450;
    letter-spacing: 0.09em;
    white-space: nowrap;
  }

  .path__role-date--single {
    font-size: 13px;
  }

  .path__role-date--primary {
    color: var(--fg);
  }

  /* El rango del rol anterior. Baja un escalón respecto al actual, pero no
     hasta --faint: ese nivel queda para la duración. */
  .path__role-date--secondary {
    color: var(--dim);
  }

  .path__aside {
    text-align: right;
    flex: none;
  }

  /*
   * Móvil. La sección se diseñó a un solo ancho y no tenía ninguna media
   * query. En un teléfono de 390 px quedan 269 para el cuerpo de la fila, y la
   * fecha —`flex: none` con `white-space: nowrap`— se llevaba ~125: al nombre
   * del rol le sobraban ~130, así que "Mobile Developer" se partía en dos
   * líneas y "Mobile & Web Developer" en tres. La solución no es encoger la
   * tipografía sino dejar de pelear por la misma línea.
   */
  @media (max-width: 640px) {
    /* El rango baja bajo el nombre del rol en vez de disputarle el ancho. */
    .path__role-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 3px;
    }

    .path__role-date {
      text-align: left;
    }

    /* En las filas de un solo puesto, fecha y duración pasan juntas a una
       línea propia, sangradas hasta el borde del texto para que la columna
       del logo siga leyéndose como columna. */
    .path__row--single {
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .path__aside {
      /* `flex: none` impediría encoger, y con el margen la línea desbordaría
         el ancho de la fila. */
      flex: 1 1 100%;
      margin-left: calc(clamp(46px, 5vw, 60px) + clamp(16px, 2.4vw, 28px));
      margin-top: 12px;
      text-align: left;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .path__dur:not(.path__dur--floating) {
      margin-top: 0;
    }
  }
</style>
