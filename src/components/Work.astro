---
import type { Lang, Dict } from '../i18n';
import { Image } from 'astro:assets';
import SectionHeader from './ui/SectionHeader.astro';
import PhoneFrame from './ui/PhoneFrame.astro';
import { apps } from '../data/apps';
import { appCopy } from '../i18n/apps';

interface Props {
  lang: Lang;
  t: Dict;
}

const { lang, t } = Astro.props;

// El teléfono arranca mostrando la primera app; el resto de estados
// vive en el DOM desde el inicio y el CSS decide cuál se ve.
const defaultApp = apps[0].num;
---

<section id="work" data-app-current={defaultApp}>
  <SectionHeader icon="badge-apps" badge={t.workBadge} gap="44px">
    <h2>{t.workA}<em>{t.workEm}</em>{t.workB}</h2>
  </SectionHeader>

  <div class="work__grid">
    <div class="work__phone-slot">
      <PhoneFrame width="min(300px,84vw)" aspect="300/610" radius="52px" innerRadius="42px" screen="card">
        <div class="phone__notch"></div>
        <div class="phone__status">
          <span>9:41</span><span>▮▮▮ ᯤ 100</span>
        </div>
        <div class="phone__body">
          <span class="phone__icons">
            {apps.map((app) => (
              <Image
                src={app.icon}
                alt={`Icono de ${app.name}`}
                width={96}
                height={96}
                data-app-icon={app.num}
                class="phone__icon"
              />
            ))}
          </span>
          {apps.map((app) => {
            const copy = appCopy[lang][app.num];
            return (
              <div class="phone__panel" data-app-panel={app.num}>
                <div>
                  <div class="phone__name">{app.name}</div>
                  <div class="phone__tag">{copy.tag}</div>
                </div>
                <p class="phone__desc">{copy.desc}</p>
                <div class="phone__meta">
                  <span>{app.year}</span><span>{copy.role}</span>
                </div>
              </div>
            );
          })}
        </div>
        <div class="phone__home"></div>
      </PhoneFrame>
    </div>

    <div class="work__list">
      {apps.map((app) => {
        const copy = appCopy[lang][app.num];
        return (
          <button type="button" data-app-pick={app.num} class="slide-row work__item">
            <span class="work__num">{app.num}</span>
            <span>
              <span class="work__name">{app.name}</span>
              <span class="work__short">{copy.short}</span>
            </span>
            <span class="work__tag">{copy.tag}</span>
          </button>
        );
      })}
      <p class="work__note">{t.workNote}</p>
    </div>
  </div>
</section>

<style>
  #work {
    position: relative;
    padding: 9vh 5vw;
    border-bottom: 1px solid var(--line);
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .work__phone-slot {
    justify-self: center;
    max-width: 100%;
  }

  /* --- pantalla del teléfono --- */

  .phone__notch {
    position: absolute;
    top: 9px;
    left: 50%;
    transform: translateX(-50%);
    width: 86px;
    height: 24px;
    border-radius: 999px;
    background: var(--bg);
    z-index: 3;
  }

  .phone__status {
    display: flex;
    justify-content: space-between;
    padding: 13px 22px 0;
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--dim);
    z-index: 2;
  }

  .phone__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 26px 24px 40px;
    text-align: center;
    position: relative;
  }

  .phone__icons {
    position: relative;
    width: 96px;
    height: 96px;
    display: block;
  }

  .phone__icon {
    position: absolute;
    inset: 0;
    width: 96px;
    height: 96px;
    border-radius: 24px;
    object-fit: cover;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* solo el estado activo se ve; el resto queda fuera de flujo y sin foco */
  .phone__panel {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  [data-app-current='01'] .phone__icon[data-app-icon='01'],
  [data-app-current='02'] .phone__icon[data-app-icon='02'],
  [data-app-current='03'] .phone__icon[data-app-icon='03'],
  [data-app-current='04'] .phone__icon[data-app-icon='04'],
  [data-app-current='05'] .phone__icon[data-app-icon='05'] {
    opacity: 1;
  }

  [data-app-current='01'] .phone__panel[data-app-panel='01'],
  [data-app-current='02'] .phone__panel[data-app-panel='02'],
  [data-app-current='03'] .phone__panel[data-app-panel='03'],
  [data-app-current='04'] .phone__panel[data-app-panel='04'],
  [data-app-current='05'] .phone__panel[data-app-panel='05'] {
    opacity: 1;
    visibility: visible;
    position: relative;
  }

  .phone__name {
    font-family: var(--appfont);
    font-style: var(--appstyle);
    letter-spacing: var(--apptrack);
    text-transform: var(--appcase);
    font-size: 26px;
    line-height: 1.15;
  }

  .phone__tag {
    font-family: var(--label);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 8px;
  }

  .phone__desc {
    margin: 0;
    font-size: 12px;
    line-height: 1.85;
    letter-spacing: 0.015em;
    color: var(--dim);
    text-wrap: pretty;
  }

  .phone__meta {
    width: 100%;
    border-top: 1px solid var(--line);
    padding-top: 14px;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  .phone__home {
    height: 5px;
    width: 110px;
    border-radius: 3px;
    background: var(--fg);
    opacity: 0.5;
    margin: 0 auto 10px;
  }

  /* --- lista de apps --- */

  .work__list {
    display: flex;
    flex-direction: column;
  }

  .work__item {
    cursor: none;
    text-align: left;
    font: inherit;
    color: var(--fg);
    background: none;
    border: none;
    border-top: 1px solid var(--line);
    padding: 22px 4px;
    display: grid;
    grid-template-columns: 34px 1fr auto;
    gap: 18px;
    align-items: baseline;
    opacity: 0.42;
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-app-current='01'] .work__item[data-app-pick='01'],
  [data-app-current='02'] .work__item[data-app-pick='02'],
  [data-app-current='03'] .work__item[data-app-pick='03'],
  [data-app-current='04'] .work__item[data-app-pick='04'],
  [data-app-current='05'] .work__item[data-app-pick='05'] {
    opacity: 1;
  }

  .work__num {
    font-size: 11px;
    color: var(--faint);
  }

  .work__name {
    font-family: var(--appfont);
    font-style: var(--appstyle);
    letter-spacing: var(--apptrack);
    text-transform: var(--appcase);
    font-size: clamp(22px, 3vw, 34px);
    display: block;
    line-height: 1.25;
  }

  .work__short {
    font-size: 12.5px;
    color: var(--dim);
    display: block;
    margin-top: 8px;
    line-height: 1.8;
    letter-spacing: 0.012em;
    max-width: 52ch;
  }

  .work__tag {
    font-family: var(--label);
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  .work__note {
    border-top: 1px solid var(--line);
    margin: 0;
    padding: 20px 4px 0;
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.07em;
    line-height: 1.7;
  }
</style>
