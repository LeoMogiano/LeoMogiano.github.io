---
import { Image } from 'astro:assets';
import type { Dict } from '../i18n';
import egg from '../assets/egg.webp';

interface Props { t: Dict }
const { t } = Astro.props;

// Valores exactos del legacy; los delays con decimales largos (ruido de coma
// flotante) se redondean a 2.1 y 4.2.
const floaters = [
  { emoji: '❤️', left: '9%', size: '26px', duration: '7s', delay: '0s' },
  { emoji: '😻', left: '21%', size: '38px', duration: '8s', delay: '0.7s' },
  { emoji: '🐰', left: '33%', size: '50px', duration: '9s', delay: '1.4s' },
  { emoji: '💕', left: '45%', size: '26px', duration: '10s', delay: '2.1s' },
  { emoji: '😽', left: '57%', size: '38px', duration: '7s', delay: '2.8s' },
  { emoji: '💘', left: '69%', size: '50px', duration: '8s', delay: '3.5s' },
  { emoji: '💖', left: '81%', size: '26px', duration: '9s', delay: '4.2s' },
];
---

<div data-egg hidden class="egg" tabindex="-1"
  role="dialog" aria-modal="true" aria-label={t.eggCaption}>
  <div class="egg__floaters">
    {floaters.map((f) => (
      <span
        aria-hidden="true"
        class="egg__floater"
        style={`left:${f.left};font-size:${f.size};animation-duration:${f.duration};animation-delay:${f.delay}`}
      >{f.emoji}</span>
    ))}
  </div>
  <figure class="egg__polaroid">
    <Image src={egg} alt="" width={360} height={450} class="egg__img" loading="lazy" />
    <figcaption class="egg__caption">{t.eggCaption}</figcaption>
  </figure>
  <span class="egg__close">{t.eggClose}</span>
</div>

<style>
  .egg {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 90;
    align-items: center;
    justify-content: center;
    background: rgba(6, 6, 8, .82);
    backdrop-filter: blur(10px);
    animation: fadeIn .5s ease both;
  }

  .egg:not([hidden]) {
    display: flex;
  }

  .egg__floaters {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .egg__floater {
    position: absolute;
    bottom: -60px;
    line-height: 1;
    animation-name: floatUp;
    animation-timing-function: ease-in;
    animation-iteration-count: infinite;
    opacity: 0;
  }

  .egg__polaroid {
    margin: 0;
    background: #f6f3ec;
    padding: 14px 14px 22px;
    border-radius: 4px;
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, .8);
    animation: polaroid 1.1s cubic-bezier(.22, 1.4, .36, 1) both;
    max-width: min(360px, 84vw);
  }

  :global(.egg__img) {
    display: block;
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    border-radius: 2px;
  }

  .egg__caption {
    font-family: var(--display);
    font-size: 26px;
    color: #1b1a16;
    text-align: center;
    margin-top: 16px;
    letter-spacing: .01em;
  }

  .egg__close {
    position: absolute;
    bottom: 6vh;
    font-family: var(--label);
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .4);
  }
</style>
