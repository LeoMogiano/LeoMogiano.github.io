---
import Icon from './ui/Icon.astro';
import type { Dict } from '../i18n';
import { socials } from '../data/socials';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---
<section id="hello" class="contact">
  <div class="contact__cta-wrap">
    <a href="mailto:leomogiano@outlook.com" class="contact__cta">{t.ctaA}<em class="contact__cta-em">{t.ctaEm}</em>{t.ctaB}</a>
    <a href="mailto:leomogiano@outlook.com" class="contact__email">leomogiano@outlook.com</a>
    <a href={`/cv/leo-mogiano-cv-${t.code.slice(0, 2)}.pdf`} class="contact__cv" target="_blank" rel="noopener" aria-label={t.cvAria}>
      <Icon name="file-down" size="13px" />
      {t.cvLabel} (PDF)
    </a>
  </div>
  <footer class="contact__foot">
    <span>© 2026 Leo Mogiano</span>
    <span class="contact__socials">
      {socials.map((social) => (
        <a
          href={social.href}
          class="contact__social"
          target={social.external ? '_blank' : undefined}
          rel={social.external ? 'noopener noreferrer' : undefined}
        >
          <Icon name={social.icon} size="13px" />
          {social.label}
        </a>
      ))}
    </span>
    <span>{t.fromBolivia}</span>
  </footer>
</section>

<style>
  .contact {
    padding: 6vh 5vw calc(7vh + env(safe-area-inset-bottom));
  }

  .contact__cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding: 2vh 0 3vh;
  }

  .contact__cta {
    font-family: var(--display);
    font-size: clamp(32px, 6.4vw, 88px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-wrap: balance;
    max-width: 16ch;
  }

  .contact__cta-em {
    color: var(--accent);
  }

  .contact__email {
    font-family: var(--label);
    font-size: var(--fs-meta);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    padding: 12px 0;
  }

  .contact__cv {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-family: var(--label);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .contact__foot {
    font-family: var(--label);
    display: flex;
    flex-wrap: wrap;
    gap: 18px 30px;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    margin-top: 70px;
    padding-top: 22px;
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .contact__socials {
    display: flex;
    gap: 24px;
  }

  .contact__social {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    color: var(--dim);
  }
</style>
