---
import type { Lang, Dict } from '../i18n';
import { Image, getImage } from 'astro:assets';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import PhoneFrame from './ui/PhoneFrame.astro';
import { apps } from '../data/apps';
import { appCopy } from '../i18n/apps';

interface Props {
  lang: Lang;
  t: Dict;
}

const { lang, t } = Astro.props;

// El teléfono arranca mostrando la primera app; el resto de estados
// vive en el DOM desde el inicio y el CSS decide cuál se ve.
const defaultApp = apps[0].num;

/*
 * Las capturas no pasan por <Image> sino por getImage(), para poder guardarlas
 * en data-src y decidir nosotros cuándo se piden. Con loading="lazy" no
 * alcanza: el umbral de Chrome llega a unos 3000 px y el teléfono está a 1900
 * del inicio, así que cuatro de las cinco se descargaban —250 KB— en la carga
 * de la portada, para alguien que quizá nunca baja hasta aquí.
 *
 * Solo viaja en el HTML la primera captura de la app que el teléfono muestra
 * al cargar. Las demás las pide src/scripts/app-shots.ts: las de la misma app,
 * al primer gesto sobre el carrusel; las de las otras, cuando se las elige.
 */
const shotSources = await Promise.all(
  apps
    .filter((app) => app.shots?.length)
    .map(async (app) => [
      app.num,
      await Promise.all(
        app.shots!.map(async (shot) => {
          const [small, large] = await Promise.all([
            getImage({ src: shot, width: 300 }),
            getImage({ src: shot, width: 600 }),
          ]);
          return {
            src: small.src,
            srcset: `${small.src} 300w, ${large.src} 600w`,
            height: Math.round((300 * shot.height) / shot.width),
          };
        }),
      ),
    ] as const),
);
const shotsByApp = new Map(shotSources);
---

<section id="work" data-app-current={defaultApp}>
  <SectionHeader icon="badge-apps" badge={t.workBadge} gap="44px">
    <h2>{t.workA}<em>{t.workEm}</em>{t.workB}</h2>
  </SectionHeader>

  <div class="work__grid">
    <div class="work__phone-slot">
      <PhoneFrame width="min(300px,84vw)" screen="card">
        <div class="phone__status">
          <span>9:41</span>
          <span class="phone__signals">
            <Icon name="signal" size="11px" />
            <Icon name="wifi" size="11px" />
            100
            <Icon name="battery" size="17px" />
          </span>
        </div>
        <div class="phone__body">
          <span class="phone__icons">
            {apps.map((app) => (
              <Image
                src={app.icon}
                alt={`Icono de ${app.name}`}
                width={96}
                height={96}
                data-app-icon={app.num}
                class="phone__icon"
              />
            ))}
          </span>
          {apps.map((app) => {
            const copy = appCopy[lang][app.num];
            return (
              <div class="phone__panel" data-app-panel={app.num}>
                <div>
                  <div class="phone__name">{app.name}</div>
                  <div class="phone__tag">{copy.tag}</div>
                </div>
                <p class="phone__desc">{copy.desc}</p>
                <div class="phone__meta">
                  <span>{app.year}</span><span>{copy.role}</span>
                </div>
              </div>
            );
          })}
        </div>

        {apps.filter((app) => app.shots?.length).map((app) => (
          <div class="phone__shots" data-app-shots={app.num}>
            <div
              class="phone__track"
              data-shots-track
              role="region"
              aria-label={t.shotsAria.replace('{app}', app.name)}
              tabindex="0"
            >
              {(shotsByApp.get(app.num) ?? []).map((shot, i) => (
                <div class="phone__slide" data-shots-slide>
                  <img
                    src={i === 0 && app.num === defaultApp ? shot.src : undefined}
                    srcset={i === 0 && app.num === defaultApp ? shot.srcset : undefined}
                    data-shot-src={i === 0 && app.num === defaultApp ? undefined : shot.src}
                    data-shot-srcset={i === 0 && app.num === defaultApp ? undefined : shot.srcset}
                    sizes="300px"
                    width="300"
                    height={shot.height}
                    alt={t.shotAlt.replace('{app}', app.name).replace('{n}', String(i + 1))}
                    loading="lazy"
                    decoding="async"
                    class="phone__shot"
                  />
                </div>
              ))}
            </div>
            <div class="phone__dots" data-shots-dots>
              {app.shots!.map((_, i) => (
                <button
                  type="button"
                  class="phone__dot"
                  data-shots-dot={i}
                  aria-label={t.shotGo.replace('{app}', app.name).replace('{n}', String(i + 1))}
                  aria-current={i === 0 ? 'true' : 'false'}></button>
              ))}
            </div>
          </div>
        ))}
      </PhoneFrame>
    </div>

    <div class="work__list">
      {apps.map((app) => {
        const copy = appCopy[lang][app.num];
        return (
          <button type="button" data-app-pick={app.num} aria-pressed={app.num === apps[0]?.num} class="slide-row work__item">
            <span class="work__num">{app.num}</span>
            <span>
              <span class="work__name" data-app-name>{app.name}</span>
              <span class="work__short">{copy.short}</span>
            </span>
            <span class="work__tag">{copy.tag}</span>
          </button>
        );
      })}
      <p class="work__note">{t.workNote}</p>
    <p class="sr-only" role="status" aria-live="polite" data-app-status data-app-status-label={t.appSelected}></p>
    </div>
  </div>
</section>

<style>
  #work {
    position: relative;
    padding: 9vh 5vw;
    border-bottom: 1px solid var(--line);
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .work__phone-slot {
    justify-self: center;
    max-width: 100%;
  }

  /* --- pantalla del teléfono --- */

  .phone__status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* Centrada con la isla, igual que la barra que traen las capturas. */
    padding: 11px 22px 0;
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--dim);
    /* Encima de las capturas: la barra de estado es del aparato, no de la app.
       A las capturas se les recortó la suya en prepare-assets. */
    position: relative;
    z-index: 4;
  }

  /* La captura trae su propia barra de estado, con su reloj y sus iconos. Dos
     barras a la vez delatan el montaje, así que manda la de la app. Hoy las
     cinco tienen capturas; se enumeran igual que el resto de reglas del
     archivo, para que quitarle las capturas a una sea borrar su línea. */
  [data-app-current='01'] .phone__status,
  [data-app-current='02'] .phone__status,
  [data-app-current='03'] .phone__status,
  [data-app-current='04'] .phone__status,
  [data-app-current='05'] .phone__status {
    visibility: hidden;
  }

  /*
   * El home indicator del marco se apaga donde la captura trae el suyo, o se
   * verían dos barras juntas. No es toda app con capturas: `cover` recorta
   * unos pocos píxeles por abajo y algunas pantallas —la portada de EGX One,
   * el ingreso de EGX Staff— nunca lo tuvieron dibujado. Ahí lo pone el marco,
   * que para eso es un teléfono.
   *
   * La variable la lee PhoneFrame; viaja por herencia desde aquí.
   */
  [data-app-current='02'] .work__phone-slot,
  [data-app-current='04'] .work__phone-slot,
  [data-app-current='05'] .work__phone-slot {
    --indicator: 0;
  }

  /* Cobertura, wifi y batería son iconos, no glifos: el subset latin de DM Sans
     no trae ▮ ni ᯤ, así que caían al font del sistema y en Windows y Android
     salían como cuadros vacíos. */
  .phone__signals {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }


  .phone__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 26px 24px 40px;
    text-align: center;
    position: relative;
  }

  .phone__icons {
    position: relative;
    width: 96px;
    height: 96px;
    display: block;
  }

  .phone__icon {
    position: absolute;
    inset: 0;
    width: 96px;
    height: 96px;
    border-radius: 24px;
    object-fit: cover;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* solo el estado activo se ve; el resto queda fuera de flujo y sin foco */
  .phone__panel {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  [data-app-current='01'] .phone__icon[data-app-icon='01'],
  [data-app-current='02'] .phone__icon[data-app-icon='02'],
  [data-app-current='03'] .phone__icon[data-app-icon='03'],
  [data-app-current='04'] .phone__icon[data-app-icon='04'],
  [data-app-current='05'] .phone__icon[data-app-icon='05'] {
    opacity: 1;
  }

  [data-app-current='01'] .phone__panel[data-app-panel='01'],
  [data-app-current='02'] .phone__panel[data-app-panel='02'],
  [data-app-current='03'] .phone__panel[data-app-panel='03'],
  [data-app-current='04'] .phone__panel[data-app-panel='04'],
  [data-app-current='05'] .phone__panel[data-app-panel='05'] {
    opacity: 1;
    visibility: visible;
    position: relative;
  }

  .phone__name {
    font-family: var(--appfont);
    font-style: var(--appstyle);
    letter-spacing: var(--apptrack);
    text-transform: var(--appcase);
    font-size: 26px;
    line-height: 1.15;
  }

  .phone__tag {
    font-family: var(--label);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 8px;
  }

  .phone__desc {
    margin: 0;
    font-size: 12px;
    line-height: 1.85;
    letter-spacing: 0.015em;
    color: var(--dim);
    text-wrap: pretty;
  }

  .phone__meta {
    width: 100%;
    border-top: 1px solid var(--line);
    padding-top: 14px;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  /* --- capturas reales dentro de la pantalla --- */

  /* Van encima de la ficha, tapando también la barra de estado: la captura
     trae la suya, y dos barras a la vez delatarían el montaje. La isla y el
     home indicator del marco quedan por encima (z-index 3). */
  .phone__shots {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease;
  }

  [data-app-current='01'] .phone__shots[data-app-shots='01'],
  [data-app-current='02'] .phone__shots[data-app-shots='02'],
  [data-app-current='03'] .phone__shots[data-app-shots='03'],
  [data-app-current='04'] .phone__shots[data-app-shots='04'],
  [data-app-current='05'] .phone__shots[data-app-shots='05'] {
    opacity: 1;
    visibility: visible;
  }

  /* El carrusel es un scroller nativo con scroll-snap: el gesto táctil, el
     scroll horizontal del trackpad y las flechas del teclado ya funcionan sin
     una línea de JS. El script solo lo avanza solo y sincroniza los puntos. */
  .phone__track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* Al llegar al final del carrusel el gesto no debe seguir de largo y
       arrastrar la página. */
    overscroll-behavior-x: contain;
  }

  .phone__track::-webkit-scrollbar {
    display: none;
  }

  .phone__track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .phone__slide {
    flex: none;
    width: 100%;
    height: 100%;
    overflow: hidden;
    scroll-snap-align: center;
    /* Red de seguridad del mismo problema: si algún día vuelve a faltar un
       subpíxel, que lo que asome sea negro de bisel y no fondo de página. */
    background: #08080a;
  }

  /*
   * Ancho exacto y anclada arriba. Hubo una versión con la imagen al 104% para
   * hacer parallax, y se veía mal: `cover` paga ese ancho de más recortando 14
   * px por arriba, y la barra de estado de la captura terminaba pisando la
   * Dynamic Island. La sensación de carrusel la dan la curva y la inercia del
   * script, que no tocan la geometría.
   */
  .phone__shot {
    /*
     * Un píxel de más por la derecha y por abajo, que el slide recorta. La
     * pantalla mide 293.4 x 628.2 y el navegador redondea la imagen a enteros:
     * quedaba una fracción de píxel sin cubrir por la que asomaba el fondo de
     * la pantalla, blanco en el tema claro. Se veía como una raya.
     */
    width: calc(100% + 1px);
    height: calc(100% + 1px);
    object-fit: cover;
    object-position: top;
    /* Sin esto, arrastrar el carrusel con el mouse arranca el drag&drop del
       navegador: aparece el fantasma de la imagen y el gesto se pierde. */
    user-select: none;
    -webkit-user-drag: none;
  }

  /*
   * Escondidos salvo cuando dicen algo. Sobre la captura, cinco puntos fijos
   * son un adorno que tapa la app; aparecen al cambiar de captura, al
   * arrastrar, al pasar por encima y al recibir foco, y se van solos.
   *
   * pointer-events se apaga con ellos: un botón invisible que igual se puede
   * pulsar es peor que no tenerlo.
   */
  .phone__dots {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    /* Justo encima del home indicator del marco, sin pisarlo. */
    bottom: 16px;
    display: flex;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 999px;
    /* La captura de abajo es impredecible: sin este fondo los puntos
       desaparecen sobre un fondo claro. */
    background: rgba(0, 0, 0, 0.35);
  }

  /* El desenfoque va solo mientras se ven: un backdrop-filter permanente
     obliga a componer el fondo en cada frame del carrusel, incluso con los
     puntos invisibles. */
  .phone__dots[data-visible],
  .phone__dots:focus-within {
    opacity: 1;
    pointer-events: auto;
    backdrop-filter: blur(6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .phone__dots {
      transition: none;
    }
  }

  .phone__dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: none;
    border-radius: 50%;
    cursor: none;
    background: rgba(255, 255, 255, 0.4);
    transition: background 0.25s ease;
  }

  .phone__dot[aria-current='true'] {
    background: #fff;
  }

  /* --- lista de apps --- */

  .work__list {
    display: flex;
    flex-direction: column;
  }

  .work__item {
    cursor: none;
    text-align: left;
    font: inherit;
    color: var(--fg);
    background: none;
    border: none;
    border-top: 1px solid var(--line);
    padding: 22px 4px;
    display: grid;
    grid-template-columns: 34px 1fr auto;
    gap: 18px;
    align-items: baseline;
    /*
     * La app no seleccionada NO se atenúa con opacity: al multiplicar el alfa
     * del texto lo dejaba en 2.9:1. La diferencia la marca el color del
     * nombre —var(--dim) contra var(--fg)—, y ambos pasan contraste.
     */
    transition: color 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .work__name {
    color: var(--dim);
    transition: color 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-app-current='01'] .work__item[data-app-pick='01'] .work__name,
  [data-app-current='02'] .work__item[data-app-pick='02'] .work__name,
  [data-app-current='03'] .work__item[data-app-pick='03'] .work__name,
  [data-app-current='04'] .work__item[data-app-pick='04'] .work__name,
  [data-app-current='05'] .work__item[data-app-pick='05'] .work__name {
    color: var(--fg);
  }

  .work__num {
    font-size: 11px;
    color: var(--faint);
  }

  .work__name {
    font-family: var(--appfont);
    font-style: var(--appstyle);
    letter-spacing: var(--apptrack);
    text-transform: var(--appcase);
    font-size: clamp(22px, 3vw, 34px);
    display: block;
    line-height: 1.25;
  }

  .work__short {
    font-size: 12.5px;
    color: var(--dim);
    display: block;
    margin-top: 8px;
    line-height: 1.8;
    letter-spacing: 0.012em;
    max-width: 52ch;
  }

  .work__tag {
    font-family: var(--label);
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  .work__note {
    border-top: 1px solid var(--line);
    margin: 0;
    padding: 20px 4px 0;
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.07em;
    line-height: 1.7;
  }
</style>
