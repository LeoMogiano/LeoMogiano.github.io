---
/**
 * Badge + título de sección, apilados.
 *
 * El badge es un contador de posición, no un adorno: la barra segmentada dice
 * cuántas secciones hay y en cuál estás. Por eso no lleva icono ni píldora —
 * un contenedor solo separa figura de fondo cuando hay algo de lo que
 * separarse, y esto va solo sobre fondo plano.
 *
 * Lo visual queda oculto al lector de pantalla y en su lugar va una frase
 * completa: leer «cero uno barra cero tres» no dice nada.
 */
interface Props {
  /** Posición de esta sección, empezando en 1. */
  num: number;
  /** Cuántas secciones numeradas hay en total. */
  total?: number;
  label: string;
  /** Frase para lectores de pantalla, con {n}, {total} y {label}. */
  aria: string;
  /** Margen inferior. Play usa 26px; Work y Path, 44px. */
  gap?: string;
}

const { num, total = 3, label, aria, gap = '44px' } = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');
const srText = aria
  .replace('{n}', String(num))
  .replace('{total}', String(total))
  .replace('{label}', label);
---

<div class="section-header" style={`margin-bottom:${gap}`}>
  <div class="section-header__badge">
    <span class="sr-only">{srText}</span>
    <span class="section-header__bar" aria-hidden="true">
      {Array.from({ length: total }, (_, i) => (
        <span class:list={['section-header__seg', i < num && 'is-on']}></span>
      ))}
    </span>
    <span class="section-header__count" aria-hidden="true">
      <span class="section-header__num">{pad(num)}</span>
      <span class="section-header__total">/{pad(total)}</span>
    </span>
    <span class="section-header__label" aria-hidden="true">{label}</span>
  </div>
  <slot />
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .section-header__badge {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--label);
    font-size: 10px;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }

  /* --- barra segmentada --- */

  .section-header__bar {
    display: inline-flex;
    gap: 4px;
  }

  /* Los segmentos apagados no desaparecen: la barra tiene que decir cuántas
     secciones faltan, no solo cuántas van. */
  .section-header__seg {
    width: 14px;
    height: 2px;
    border-radius: 999px;
    background: var(--line);
    transition: background 0.3s ease;
  }

  .section-header__seg.is-on {
    background: var(--accent);
  }

  /* --- contador --- */

  .section-header__count {
    display: inline-flex;
    /* Sin tracking: son cifras, no una etiqueta. Con 0.14em el `/` quedaba
       flotando lejos de los dos números que separa. */
    letter-spacing: 0;
  }

  .section-header__num {
    color: var(--fg);
  }

  .section-header__total {
    color: var(--faint);
  }

  .section-header__label {
    color: var(--dim);
  }

  .section-header :global(h2) {
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(30px, 5vw, 62px);
    line-height: 1.08;
    letter-spacing: 0.005em;
  }

  .section-header :global(h2 em) {
    color: var(--accent);
  }
</style>
