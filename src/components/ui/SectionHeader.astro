---
/**
 * Badge + título de sección, apilados.
 *
 * En el legacy el badge iba en `position:absolute; top:9vh; right:5vw` y se
 * cruzaba con el título cuando este crecía. Vive apilado en una columna, y
 * al estar en un solo componente las tres secciones no pueden divergir.
 */
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

interface Props {
  icon: IconName;
  badge: string;
  /** Margen inferior. Play usa 26px; Work y Path, 44px. */
  gap?: string;
}

const { icon, badge, gap = '44px' } = Astro.props;
---

<div class="section-header" style={`margin-bottom:${gap}`}>
  <div class="section-header__badge">
    <Icon name={icon} size="13px" />
    {badge}
  </div>
  <slot />
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .section-header__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 14px;
    background: var(--card);
    font-family: var(--label);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .section-header :global(h2) {
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(30px, 5vw, 62px);
    line-height: 1.08;
    letter-spacing: 0.005em;
  }

  .section-header :global(h2 em) {
    color: var(--accent);
  }
</style>
